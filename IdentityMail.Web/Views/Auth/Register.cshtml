@model RegisterDTO
@{
    ViewData["Title"]     = "Kayıt Ol";
    Layout                = "/Views/Shared/_AuthLayout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/auth/register.css" asp-append-version="true" />
}

<div class="register-page">
    <div class="register-left">
        <div class="brand">
            <div class="brand-icon">
                <span class="material-symbols-outlined">mail</span>
            </div>
            <span class="brand-name">B-Mail</span>
        </div>
        <div class="hero-content">
            <h1>Yeni bir başlangıç, tek bir hesap.</h1>
            <p>B-Mail hesabını oluştur, mesajlarını güvenli ve düzenli bir şekilde yönetmeye başla.</p>
            <div class="message-preview">
                <div class="message-header">
                    <div class="avatar">BG</div>
                    <div class="message-user">
                        <div class="message-line line-name"></div>
                        <div class="message-line line-small"></div>
                    </div>
                </div>
                <div class="message-body">
                    <div class="message-line line-full"></div>
                    <div class="message-line line-medium"></div>
                    <div class="message-line line-short"></div>
                </div>
            </div>
        </div>
        <div class="security-text">
            <span class="material-symbols-outlined">lock</span>
            Kurumsal Sınıf Güvenlik
        </div>
    </div>
    <div class="register-right">
        <div class="register-form-container">
            <div class="form-header">
                <h2>Hesap Oluştur</h2>
                <p>Hesabını oluştur ve mesajlaşmaya başla.</p>
            </div>
            <form method="post">
                <div id="validationSummary">
                    @Html.ValidationSummary(false, "", new { @class = "validation-message" })
                </div>
                <div class="name-row">
                    <div class="form-group">
                        <label asp-for="FirstName">Ad</label>
                        <div class="input-wrapper">
                            <span class="material-symbols-outlined input-icon">person</span>
                            <input asp-for="FirstName" class="form-input" placeholder="Adınız" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="LastName">Soyad</label>
                        <div class="input-wrapper">
                            <span class="material-symbols-outlined input-icon">person</span>
                            <input asp-for="LastName" class="form-input" placeholder="Soyadınız" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="UserName">Kullanıcı Adı</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-outlined input-icon">alternate_email</span>
                        <input asp-for="UserName" class="form-input" placeholder="kullaniciadi" />
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="Email">E-posta Adresi</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-outlined input-icon">mail</span>
                        <input asp-for="Email" class="form-input" placeholder="ornek@info.com" type="email" />
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="Password">Şifre</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-outlined input-icon">lock</span>
                        <input asp-for="Password" id="password" class="form-input password-input" placeholder="••••••••" type="password" />
                        <button type="button" class="password-toggle" onclick="toggleRegisterPassword('password', 'passwordIcon')">
                            <span id="passwordIcon" class="material-symbols-outlined">visibility</span>
                        </button>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword">Şifre Tekrar</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-outlined input-icon">lock_reset</span>
                        <input asp-for="ConfirmPassword" id="confirmPassword" class="form-input password-input" placeholder="••••••••" type="password" />
                        <button type="button" class="password-toggle" onclick="toggleRegisterPassword('confirmPassword', 'confirmPasswordIcon')">
                            <span id="confirmPasswordIcon" class="material-symbols-outlined">visibility</span>
                        </button>
                    </div>
                </div>
                <button class="register-button" type="submit">
                    Kayıt Ol
                    <span class="material-symbols-outlined">arrow_forward</span>
                </button>
            </form>
            <div class="login-area">
                Zaten hesabın var mı?
                <a href="/Auth/Login">Giriş Yap</a>
            </div>
        </div>
    </div>
</div>
@if (ViewBag.EmailSent == true)
{
    <div class="register-success-modal">
        <div class="register-success-overlay"></div>
        <div class="register-success-box">
            <div class="register-success-icon">
                <span class="material-symbols-outlined">mark_email_read</span>
            </div>
            <h2>E-postanı Kontrol Et</h2>
            <p>Doğrulama bağlantısını <strong>@ViewBag.RegisterEmail</strong> adresine gönderdik.</p>
            <div class="register-success-note">
                Hesabını aktifleştirmek için e-postadaki
                <strong>E-postamı Doğrula</strong>
                butonuna tıkla. E-postayı göremiyorsan spam veya gereksiz klasörünü de kontrol et.
            </div>
            <a asp-controller="Auth" asp-action="Login" class="register-success-button">
                Giriş Sayfasına Dön
                <span class="material-symbols-outlined">arrow_forward</span>
            </a>
        </div>
    </div>
}