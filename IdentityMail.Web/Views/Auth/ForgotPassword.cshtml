@{
    ViewData["Title"] = "Giriş Yap";
    ViewData["BodyClass"] = "bg-[#F8FAFC] text-on-background min-h-screen flex items-center justify-center p-4";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="w-full max-w-md bg-surface-container-lowest rounded-xl border border-outline-variant/30 shadow-[0_20px_25px_-5px_rgb(0_0_0_/_0.1)] p-8 sm:p-12 relative overflow-hidden">
    <div class="absolute -top-24 -right-24 w-48 h-48 bg-surface-container-high rounded-full blur-3xl opacity-50 pointer-events-none"></div>
    <!-- Header -->
    <div class="text-center flex flex-col items-center gap-stack_sm">
        <div class="flex flex-col items-center mb-8 relative z-10">
            <div class="flex items-center justify-center w-12 h-12 bg-primary rounded-lg shadow-sm mb-4">
                <span class="material-symbols-outlined text-on-primary font-bold" data-icon="mail">mail</span>
            </div>
            <h1 class="font-display-lg text-display-lg text-primary tracking-tight">B-Mail</h1>
            <h2 class="font-headline-md text-headline-md text-on-surface mt-4">Şifremi Unuttum</h2>
            <p class="font-body-md text-body-md text-on-surface-variant text-center mt-2">
                E-posta adresinizi aşağıya girin, şifrenizi sıfırlamanız için size bir bağlantı göndereceğiz.
            </p>
        </div>
    </div>
    <!-- Form -->
    <form class="flex flex-col gap-stack_md w-full" method="post" asp-controller="Auth" asp-action="ForgotPassword">
        <div class="flex flex-col gap-1">
            <label class="font-label-md text-label-md text-on-surface" for="email">E-posta Adresi</label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <span class="material-symbols-outlined text-outline" data-icon="mail" style="font-size: 18px;">mail</span>
                </div>
                <input class="block w-full pl-10 pr-3 py-2 border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary placeholder-outline" id="email" name="email" placeholder="E-posta adresinizi girin" required="" type="email">
            </div>
        </div>
        <button class="w-full bg-primary-container text-on-primary hover:bg-secondary transition-colors duration-200 py-3 px-4 rounded-lg font-label-md text-label-md flex justify-center items-center mt-2" type="submit">
            Şifre Sıfırlama Bağlantısı Gönder
        </button>
    </form>
    <!-- Footer -->
    <div class="text-center mt-2">
        <a class="font-label-md text-label-md text-primary hover:text-secondary transition-colors duration-200 flex items-center justify-center gap-2" href="/Auth/Login">
            <span class="material-symbols-outlined" data-icon="arrow_back" style="font-size: 16px;">arrow_back</span>
            Giriş Sayfasına Dön
        </a>
    </div>
</div>