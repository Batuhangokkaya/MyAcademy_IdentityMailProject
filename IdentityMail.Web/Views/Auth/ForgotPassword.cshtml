@model ForgotPasswordDTO
@{
    ViewData["Title"] = "Giriş Yap";
    Layout            = "/Views/Shared/_AuthLayout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/auth/forgot-password.css" asp-append-version="true" />
}

<div class="forgot-page">
    <div class="forgot-card">
        <div class="forgot-header">
            <div class="forgot-logo">
                <span class="material-symbols-outlined">mail</span>
            </div>
            <h1 class="forgot-brand">B-Mail</h1>
            <h2 class="forgot-title">Şifremi Unuttum</h2>
            <p class="forgot-description">E-posta adresinizi aşağıya girin, şifrenizi sıfırlamanız için size bir bağlantı göndereceğiz.</p>
        </div>
        <form method="post" asp-controller="Auth" asp-action="ForgotPassword" class="forgot-form">
            <div class="form-group">
                <div id="validationSummary">
                    @Html.ValidationSummary(false, "", new { @class = "validation-message" })
                </div>
                <label for="email">E-posta Adresi</label>
                <div class="input-wrapper">
                    <span class="material-symbols-outlined input-icon">mail</span>
                    <input type="email" id="email" name="email" placeholder="E-posta adresinizi girin" />
                </div>
            </div>
            <button type="submit" class="forgot-button">Şifre Sıfırlama Bağlantısı Gönder</button>
        </form>
        <div class="forgot-footer">
            <a href="/Auth/Login">
                <span class="material-symbols-outlined">arrow_back</span>
                Giriş Sayfasına Dön
            </a>
        </div>
    </div>
</div>
@if (TempData["SuccessMessage"] != null)
{
    <div class="popup-overlay" id="successPopup">
        <div class="popup-card">
            <div class="popup-icon">
                <span class="material-symbols-outlined">
                    mark_email_read
                </span>
            </div>
            <h2 class="popup-title">E-posta Gönderildi!</h2>
            <p class="popup-description">@TempData["SuccessMessage"]</p>
            <p class="popup-info">Gelen kutunuzu ve spam klasörünüzü kontrol etmeyi unutmayın.</p>
            <button type="button" class="popup-button" onclick="closePopup()">Tamam</button>
        </div>
    </div>
}