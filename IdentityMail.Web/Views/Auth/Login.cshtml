@model LoginDTO
@{
    ViewData["Title"]     = "Giriş Yap";
    ViewData["BodyClass"] = "bg-[#F8FAFC] text-on-background min-h-screen flex items-center justify-center p-4";
    Layout                = "/Views/Shared/_AuthLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" />
}

<div class="login-page">
    <!-- SOL TARAF -->
    <div class="login-left">
        <!-- Logo -->
        <div class="brand">
            <div class="brand-icon">
                <span class="material-symbols-outlined">mail</span>
            </div>
            <span class="brand-name">B-Mail</span>
        </div>
        <!-- Orta içerik -->
        <div class="hero-content">
            <h1>Mesajlaşmanın daha sade hali.</h1>
            <p>Mesajlarını güvenli, hızlı ve kolay bir şekilde yönet. Odaklanman gereken tek şey içeriğin kendisi.</p>
            <!-- Dekoratif mesaj kartı -->
            <div class="message-preview">
                <div class="message-header">
                    <div class="avatar">BG</div>
                    <div class="message-user">
                        <div class="message-line line-name"></div>
                        <div class="message-line line-small"></div>
                    </div>
                </div>
                <div class="message-body">
                    <div class="message-line line-full"></div>
                    <div class="message-line line-medium"></div>
                    <div class="message-line line-short"></div>
                </div>
            </div>
        </div>
        <!-- Alt yazı -->
        <div class="security-text">
            <span class="material-symbols-outlined">lock</span>
            Kurumsal Sınıf Güvenlik
        </div>
    </div>
    <!-- SAĞ TARAF -->
    <div class="login-right">
        <div class="login-form-container">
            <div class="form-header">
                <h2>Tekrar Hoş Geldin</h2>
                <p>Hesabına giriş yaparak mesajlarına ulaş.</p>
            </div>
            <form method="post">
                <div id="validationSummary">
                    @Html.ValidationSummary(false, "", new { @class = "validation-message" })
                </div>
                <!-- Email -->
                <div class="form-group">
                    <label asp-for="Email">E-posta Adresi</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-outlined input-icon">mail</span>
                        <input asp-for="Email" class="form-input" placeholder="ornek@info.com" type="email" />
                    </div>
                </div>
                <!-- Şifre -->
                <div class="form-group">
                    <label asp-for="Password">Şifre</label>
                    <div class="input-wrapper">
                        <span class="material-symbols-outlined input-icon">lock</span>
                        <input asp-for="Password" class="form-input" placeholder="••••••••" type="password" />
                    </div>
                </div>
                <!-- Remember / Forgot -->
                <div class="form-actions">
                    <label class="remember-me">
                        <input asp-for="RememberMe" type="checkbox" />
                        <span>Beni Hatırla</span>
                    </label>
                    <a href="/Auth/ForgotPassword">Şifremi Unuttum?</a>
                </div>
                <button class="login-button" type="submit">
                    Giriş Yap
                    <span class="material-symbols-outlined">arrow_forward</span>
                </button>
            </form>
            <div class="register-area">
                Hesabın yok mu?
                <a href="/Auth/Register">Kayıt Ol</a>
            </div>
        </div>
    </div>
</div>