@model ResetPasswordDTO
@{
    ViewData["Title"] = "Şifreyi Yenile";
    Layout            = "/Views/Shared/_AuthLayout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/auth/reset-password.css" asp-append-version="true" />
}

<div class="reset-page">
    <div class="reset-card">
        <div class="reset-header">
            <div class="reset-logo">
                <span class="material-symbols-outlined">mail</span>
            </div>
            <h1 class="reset-brand">B-Mail</h1>
            <h2 class="reset-title">Şifreyi Yenile</h2>
            <p class="reset-description">B-Mail hesabınız için yeni bir şifre oluşturun.</p>
        </div>
        <form asp-controller="Auth" asp-action="ResetPassword" method="post" class="reset-form">
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div class="form-group">
                <div id="validationSummary">
                    @Html.ValidationSummary(false, "", new { @class = "validation-message" })
                </div>
                <label asp-for="Password">Yeni Şifre</label>
                <div class="password-wrapper">
                    <input asp-for="Password" id="new-password" type="password" placeholder="Yeni şifrenizi girin" />
                    <button type="button" class="password-toggle" onclick="togglePassword('new-password', this)">
                        <span class="material-symbols-outlined">visibility_off</span>
                    </button>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword">Yeni Şifreyi Tekrarla</label>
                <div class="password-wrapper">
                    <input asp-for="ConfirmPassword" id="confirm-password" type="password" placeholder="Yeni şifrenizi tekrar girin" />
                    <button type="button" class="password-toggle" onclick="togglePassword('confirm-password', this)">
                        <span class="material-symbols-outlined">visibility_off</span>
                    </button>
                </div>
            </div>
            <button type="submit" class="reset-button">Şifreyi Yenile</button>
        </form>
        <div class="reset-footer">
            <a asp-controller="Auth" asp-action="Login" class="back-login">
                <span class="material-symbols-outlined">arrow_back</span>
                Giriş Sayfasına Dön
            </a>
        </div>
    </div>
</div>
@if (ViewBag.PasswordResetSuccess == true)
{
    <div class="success-popup-overlay">
        <div class="success-popup">
            <div class="success-popup-icon">
                <span class="material-symbols-outlined">
                    check
                </span>
            </div>
            <h2>Şifreniz Yenilendi!</h2>
            <p>Şifreniz başarıyla yenilendi. Yeni şifrenizle giriş yapabilirsiniz.</p>
            <a asp-controller="Auth" asp-action="Login" class="success-popup-button">Tamam</a>
        </div>
    </div>
}