@model ResetPasswordDTO
@{
    ViewData["Title"]     = "Giriş Yap";
    ViewData["BodyClass"] = "bg-[#F8FAFC] text-on-background min-h-screen flex items-center justify-center p-4";
    Layout                = "/Views/Shared/_AuthLayout.cshtml";
}

<main class="w-full max-w-md bg-surface-container-lowest rounded-xl shadow-[0_4px_6px_-1px_rgb(0_0_0_/_0.05),_0_2px_4px_-2px_rgb(0_0_0_/_0.05)] border border-outline-variant p-8 md:p-10 m-4">
    <header class="flex flex-col items-center mb-8">
        <div class="w-12 h-12 bg-primary-container rounded-full flex items-center justify-center mb-4 text-on-primary-container">
            <span class="material-symbols-outlined" data-icon="mail" style="font-variation-settings: 'FILL' 1; font-size: 24px;">mail</span>
        </div>
        <h1 class="font-display-lg text-display-lg text-primary tracking-tight">B-Mail</h1>
    </header>
    <section>
        <div class="text-center mb-8">
            <h2 class="font-headline-md text-headline-md text-on-surface mb-2">Şifreyi Yenile</h2>
            <p class="font-body-md text-body-md text-on-surface-variant">B-Mail hesabınız için yeni bir şifre oluşturun.</p>
        </div>
        <form asp-controller="Auth" asp-action="ResetPassword" class="space-y-6" method="post">
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div>
                <label asp-for="Password" class="block font-label-md text-label-md text-on-surface mb-2" for="new-password">Yeni Şifre</label>
                <div class="relative">
                    <input asp-for="Password" class="w-full px-4 py-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent font-body-md text-body-md placeholder-on-surface-variant/60 transition-all duration-200" id="new-password" name="password" placeholder="Yeni şifrenizi girin" type="password" />
                    <button class="absolute inset-y-0 right-0 pr-3 flex items-center text-outline hover:text-on-surface transition-colors" type="button">
                        <span class="material-symbols-outlined text-[20px]" data-icon="visibility_off">visibility_off</span>
                    </button>
                    <span asp-validation-for="Password"></span>
                </div>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="block font-label-md text-label-md text-on-surface mb-2" for="confirm-password">Yeni Şifreyi Tekrarla</label>
                <div class="relative">
                    <input asp-for="ConfirmPassword" class="w-full px-4 py-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent font-body-md text-body-md placeholder-on-surface-variant/60 transition-all duration-200" id="confirm-password" name="ConfirmPassword" placeholder="Yeni şifrenizi girin" type="password" />
                    <button class="absolute inset-y-0 right-0 pr-3 flex items-center text-outline hover:text-on-surface transition-colors" type="button">
                        <span class="material-symbols-outlined text-[20px]" data-icon="visibility_off">visibility_off</span>
                    </button>
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>
            </div>
            <button class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm font-label-md text-label-md text-on-primary bg-primary hover:bg-secondary focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors duration-200" type="submit">
                Şifreyi Yenile
            </button>
        </form>
        <div class="mt-8 text-center">
            <a class="font-label-md text-label-md text-primary hover:text-secondary hover:underline transition-colors duration-200 flex items-center justify-center gap-2" href="/Auth/Login">
                <span class="material-symbols-outlined text-[16px]" data-icon="arrow_back">arrow_back</span>
                Giriş Sayfasına Dön
            </a>
        </div>
    </section>
</main>