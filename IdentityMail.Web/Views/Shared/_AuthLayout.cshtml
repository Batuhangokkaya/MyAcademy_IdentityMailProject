<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Login - B-Mail</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "inverse-primary": "#b4c5ff",
                        "secondary-container": "#4069f2",
                        "on-tertiary": "#ffffff",
                        "surface-dim": "#cbdbf5",
                        "outline": "#737686",
                        "surface-container": "#e5eeff",
                        "surface-container-high": "#dce9ff",
                        "surface-container-low": "#eff4ff",
                        "on-primary-container": "#eeefff",
                        "on-primary": "#ffffff",
                        "on-surface-variant": "#434655",
                        "surface-container-lowest": "#ffffff",
                        "on-surface": "#0b1c30",
                        "secondary-fixed-dim": "#b7c4ff",
                        "primary-fixed-dim": "#b4c5ff",
                        "primary-fixed": "#dbe1ff",
                        "tertiary": "#525657",
                        "inverse-on-surface": "#eaf1ff",
                        "primary": "#004ac6",
                        "on-primary-fixed-variant": "#003ea8",
                        "tertiary-container": "#6b6e70",
                        "on-tertiary-container": "#eff1f3",
                        "on-secondary-fixed": "#001551",
                        "tertiary-fixed": "#e0e3e5",
                        "secondary-fixed": "#dce1ff",
                        "tertiary-fixed-dim": "#c4c7c9",
                        "background": "#f8f9ff",
                        "error": "#ba1a1a",
                        "on-primary-fixed": "#00174b",
                        "on-background": "#0b1c30",
                        "surface-variant": "#d3e4fe",
                        "on-secondary-fixed-variant": "#0039b5",
                        "on-error-container": "#93000a",
                        "on-tertiary-fixed-variant": "#444749",
                        "surface-container-highest": "#d3e4fe",
                        "primary-container": "#2563eb",
                        "on-secondary-container": "#fffbff",
                        "error-container": "#ffdad6",
                        "on-error": "#ffffff",
                        "on-tertiary-fixed": "#191c1e",
                        "on-secondary": "#ffffff",
                        "secondary": "#1d4ed8",
                        "surface": "#f8f9ff",
                        "surface-bright": "#f8f9ff",
                        "inverse-surface": "#213145",
                        "outline-variant": "#c3c6d7",
                        "surface-tint": "#0053db"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "stack_lg": "1.5rem",
                        "sidebar_width": "260px",
                        "stack_sm": "0.5rem",
                        "navbar_height": "64px",
                        "stack_md": "1rem",
                        "gutter": "1.5rem",
                        "margin_page": "2rem"
                    },
                    "fontFamily": {
                        "label-sm": ["Inter"],
                        "display-lg": ["Inter"],
                        "body-lg": ["Inter"],
                        "label-md": ["Inter"],
                        "headline-sm-mobile": ["Inter"],
                        "headline-md": ["Inter"],
                        "body-md": ["Inter"],
                        "headline-sm": ["Inter"]
                    },
                    "fontSize": {
                        "label-sm": ["12px", { "lineHeight": "1.0", "fontWeight": "600" }],
                        "display-lg": ["32px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "body-lg": ["16px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "label-md": ["14px", { "lineHeight": "1.0", "fontWeight": "500" }],
                        "headline-sm-mobile": ["18px", { "lineHeight": "1.4", "fontWeight": "600" }],
                        "headline-md": ["24px", { "lineHeight": "1.3", "fontWeight": "600" }],
                        "body-md": ["14px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "headline-sm": ["20px", { "lineHeight": "1.4", "fontWeight": "600" }]
                    }
                }
            }
        }
    </script>
</head>
<body class="@ViewData["BodyClass"]">
    <!-- Suppressed navigation shell due to transactional intent -->
    @RenderBody()

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const summary = document.getElementById("validationSummary");

            if (summary && summary.textContent.trim() !== "") {
                summary.classList.remove("hidden");
            }

           @if (TempData["SuccessMessage"] != null)
            {
                <text>
                    Swal.fire({
                        icon: "success",
                        title: "Bağlantı Gönderildi",
                        text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"])),
                        confirmButtonText: "Tamam"
                    });
                </text>
            }
        });
    </script>
</body>
</html>