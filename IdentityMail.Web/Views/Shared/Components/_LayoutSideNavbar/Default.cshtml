@*
    Default Side Navbar
*@
@{
    var currentAction     = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<aside class="sidebar">
    <div class="sidebar-brand">
        <div class="sidebar-logo">
            <span>B</span>
        </div>
        <div class="sidebar-brand-text">
            <strong>B-Mail</strong>
            <small>Productivity Messaging</small>
        </div>
    </div>
    <button id="compose-btn" class="compose-button">
        <span class="material-symbols-outlined">edit</span>
        <span>+ Yeni Mesaj</span>
    </button>
    <nav class="sidebar-menu">
        <a href="/Message/Inbox" class="sidebar-link @(currentAction == "Inbox" ? "active" : "")">
            <span class="material-symbols-outlined">inbox</span>
            <span>Gelen Kutusu</span>
            <span class="sidebar-badge">@ViewBag.TotalInbox</span>
        </a>
        <a href="/Message/SentMails" class="sidebar-link @(currentAction == "SentMails" ? "active" : "")">
            <span class="material-symbols-outlined">send</span>
            <span>Gönderilenler</span>
            <span class="sidebar-badge">@ViewBag.TotalSentMail</span>
        </a>
        <a href="/Message/Drafts" class="sidebar-link @(currentAction == "Drafts" ? "active" : "")">
            <span class="material-symbols-outlined">draft</span>
            <span>Taslaklar</span>
            <span class="sidebar-badge">@ViewBag.TotalDraft</span>
        </a>
        <a href="/Message/ImportantMails" class="sidebar-link @(currentAction == "ImportantMails" ? "active" : "")">
            <span class="material-symbols-outlined">star</span>
            <span>Önemli Mesajlar</span>
            <span class="sidebar-badge">@ViewBag.TotalImportantMail</span>
        </a>
        <a href="/Message/Trash" class="sidebar-link @(currentAction == "Trash" ? "active" : "")">
            <span class="material-symbols-outlined">delete</span>
            <span>Çöp Kutusu</span>
            <span class="sidebar-badge">@ViewBag.TotalDeletedMail</span>
        </a>
        <a href="/Category/Index" class="sidebar-link @(currentController == "Category" && currentAction == "Index" ? "active" : "")">
            <span class="material-symbols-outlined">label</span>
            <span>Kategoriler</span>
            <span class="sidebar-badge">@ViewBag.TotalCategory</span>
        </a>
    </nav>
    <div class="sidebar-categories">
        <p class="sidebar-section-title">KATEGORİLER</p>
        @foreach (var category in Model.Categories)
        {
            <a href="/Category/Mails/@category.ID" class="category-link @(ViewBag.ActiveCategoryID == category.ID ? "active-category" : "")">
                <span class="category-dot" style="color: @category.Color;"></span>
                <span>@category.Name</span>
            </a>
        }
    </div>
    <div class="sidebar-footer">
        @if (User.IsInRole("Admin"))
        {
            <a href="/AdminUser/Index" class="sidebar-link @(currentController == "AdminUser" && currentAction == "Index" ? "active" : "")">
                <span class="material-symbols-outlined">group</span>
                <span>Kullanıcılar</span>
            </a>
            <a href="/AdminRole/Index" class="sidebar-link @(currentController == "AdminRole" ? "active" : "")">
                <span class="material-symbols-outlined">shield_person</span>
                <span>Roller</span>
            </a>
        }
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a href="/Statistics/Index" class="sidebar-link @(currentController == "Statistics" ? "active" : "")">
                <span class="material-symbols-outlined">bar_chart</span>
                <span>İstatistikler</span>
            </a>
            <a href="/AdminReport/Index" class="sidebar-link @(currentController == "AdminReport" ? "active" : "")">
                <span class="material-symbols-outlined">report</span>
                <span>Şikayet Edilenler</span>
            </a>
        }
    </div>
</aside>