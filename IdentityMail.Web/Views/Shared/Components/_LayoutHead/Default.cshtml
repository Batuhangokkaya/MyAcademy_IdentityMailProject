<style>
    body {
        font-family: 'Inter', sans-serif;
    }

    .dropdown-menu {
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);
        transition: all 0.2s ease-in-out;
    }

    .dropdown-menu.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    /* Toggle Switch Styles */
    .toggle-checkbox:checked {
        right: 0;
        border-color: #2563eb;
    }

    .toggle-checkbox:checked + .toggle-label {
        background-color: #2563eb;
    }

    #compose-window {
        transition: width 0.3s ease, height 0.3s ease, right 0.3s ease, bottom 0.3s ease, top 0.3s ease, left 0.3s ease, transform 0.3s ease, border-radius 0.3s ease;
    }

    #compose-window.is-maximized {
        width: 80vw !important;
        height: 80vh !important;
        top: 50% !important;
        left: 50% !important;
        bottom: auto !important;
        right: auto !important;
        transform: translate(-50%, -50%) !important;
        border-radius: 12px;
    }

    #compose-window.is-minimized {
        height: 48px !important;
    }
</style>