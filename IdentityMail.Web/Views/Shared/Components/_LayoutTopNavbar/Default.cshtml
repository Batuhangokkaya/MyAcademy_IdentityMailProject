@model List<Notification>
@*
    Default Top Navbar
*@

<header class="top-navbar">
    <div class="top-navbar-left">
        <div class="top-navbar-search">
            <span class="material-symbols-outlined search-icon">search</span>
            <input type="text" id="mailSearchInput" class="top-navbar-search-input" placeholder="Posta ara..." autocomplete="off" />
            <div id="mailSearchResults" class="mail-search-results"></div>
        </div>
    </div>
    <div class="top-navbar-actions">
        <div class="top-navbar-item">
            <button type="button" class="navbar-icon-btn" id="notification-bell">
                <span class="material-symbols-outlined">notifications</span>
                @if (ViewBag.UnreadNotificationCount > 0)
                {
                    <span id="notificationBadge" class="notification-dot" style="@(ViewBag.UnreadNotificationCount > 0 ? "" : "display:none;")"></span>
                }
            </button>
            <div class="navbar-dropdown notification-dropdown" id="notification-dropdown">
                <div class="notification-header">
                    <h3>Bildirimler</h3>
                    <button type="button" class="notification-read-all" id="notificationReadAll">Tümünü okundu işaretle</button>
                </div>
                <div class="notification-list">
                    @if (Model.Any())
                    {
                        foreach (var notification in Model)
                        {
                            <div class="notification-item @(!notification.IsRead ? "unread" : "")" data-id="@notification.ID" data-message-id="@notification.MessageID" role="button" tabindex="0">
                                @if (!notification.IsRead)
                                {
                                    <span class="unread-dot"></span>
                                }
                                <div class="notification-icon secondary">
                                    <span class="material-symbols-outlined">mail</span>
                                </div>
                                <div class="notification-content">
                                    <span class="notification-title">@notification.Title</span>
                                    <span class="notification-description">@notification.Description</span>
                                    <span class="notification-time" data-date="@notification.CreatedAt.ToString("O")"></span>
                                </div>
                                <button type="button" class="notification-delete" data-id="@notification.ID" title="Bildirimi sil">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="notification-empty">Henüz bildiriminiz bulunmuyor.</div>
                    }
                </div>
                <div class="notification-footer">
                    <a asp-controller="Notification" asp-action="Index">Tüm bildirimleri görüntüle</a>
                </div>
            </div>
        </div>       
        <div class="top-navbar-item">
            <button type="button" class="profile-avatar" id="profile-avatar">
                @if (!string.IsNullOrWhiteSpace(ViewBag.ProfileImage))
                {
                    <img src="@ViewBag.ProfileImage" alt="Profil fotoğrafı" />
                }
                else
                {
                    <span>@ViewBag.ProfileInitial</span>
                }   
            </button>
            <div class="navbar-dropdown profile-dropdown" id="profile-dropdown">
                <div class="profile-dropdown-header">
                    <div class="profile-dropdown-avatar">
                        @if (!string.IsNullOrWhiteSpace(ViewBag.ProfileImage))
                        {
                            <img src="@ViewBag.ProfileImage"
                                 alt="Profil fotoğrafı" />
                        }
                        else
                        {
                            <span>@ViewBag.ProfileInitial</span>
                        }
                    </div>
                    <div class="profile-dropdown-user">
                        <strong>@ViewBag.ProfileName</strong>
                        <span>@ViewBag.ProfileEmail</span>
                    </div>

                </div>
                <div class="profile-menu-section">
                    <a href="/Profile/Index">
                        <span class="material-symbols-outlined">person</span>
                        Profilim
                    </a>
                    <a href="/Profile/Settings">
                        <span class="material-symbols-outlined">manage_accounts</span>
                        Hesap Ayarları
                    </a>
                </div>
                <div class="profile-menu-section">
                    <a href="/Help/Index">
                        <span class="material-symbols-outlined">help</span>
                        Yardım ve Destek
                    </a>
                </div>
                <div class="profile-menu-section logout-section">
                    <a href="/Auth/Logout" class="logout-link">
                        <span class="material-symbols-outlined">logout</span>
                        Çıkış Yap
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>
<form id="notificationTokenForm" hidden>
    @Html.AntiForgeryToken()
</form>