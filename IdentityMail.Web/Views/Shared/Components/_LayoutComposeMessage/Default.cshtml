@model SendMailDTO
@*
    Default Compose Message
*@

<div class="hidden fixed bottom-0 right-[24px] w-[550px] h-[600px] bg-surface-container-lowest rounded-t-xl shadow-2xl border-x border-t border-outline-variant z-50 flex flex-col" id="compose-window" style="height: 600px;">
    <div class="flex items-center justify-between px-4 py-3 bg-surface-container-high rounded-t-xl cursor-pointer" id="compose-header">
        <span class="font-label-md text-label-md font-bold text-on-surface">Yeni Mail</span>
        <div class="flex items-center gap-2">
            <button class="p-1 hover:bg-surface-container-highest rounded transition-colors" id="compose-minimize">
                <span class="material-symbols-outlined text-[18px]">remove</span>
            </button>
            <button class="p-1 hover:bg-surface-container-highest rounded transition-colors" id="compose-maximize">
                <span class="material-symbols-outlined text-[18px]">open_in_full</span>
            </button>
            <button class="p-1 hover:bg-surface-container-highest rounded transition-colors" id="compose-close">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>
    </div>
    <form method="post" asp-controller="Message" asp-action="SendMail" class="flex flex-col flex-1 min-h-0">
        <input type="hidden" id="DraftID" name="DraftID" value="" />
        <div class="flex-1 flex flex-col p-4 gap-4 overflow-y-auto min-h-0" id="compose-body" style="display: flex;">
            <div class="flex items-center border-b border-outline-variant pb-2">
                <span class="text-on-surface-variant font-label-md w-16 shrink-0">Kime:</span>
                <input asp-for="ReceiverMail" class="flex-1 bg-transparent border-none focus:ring-0 text-body-md p-0" placeholder="Alıcı ara..." type="text" />
            </div>
            <div class="flex items-center border-b border-outline-variant pb-2">
                <span class="text-on-surface-variant font-label-md w-16 shrink-0">Konu:</span>
                <input asp-for="Subject" class="flex-1 bg-transparent border-none focus:ring-0 text-body-md p-0" placeholder="Konuyu girin..." type="text" />
            </div>
            <textarea asp-for="Body" class="flex-1 bg-transparent border-none focus:ring-0 text-body-md resize-none" placeholder=""></textarea>
        </div>
        <div class="p-4 border-t border-outline-variant flex items-center justify-between bg-surface-container-lowest shrink-0" id="compose-footer" style="display: flex;">
            <div class="flex gap-2">
                <button type="submit" class="px-6 py-2 bg-primary text-on-primary rounded-full font-label-md hover:bg-secondary transition-colors">Gönder</button>
                <button type="button" onclick="saveDraft()" class="px-4 py-2 text-on-surface-variant hover:bg-surface-container-low rounded-lg font-label-md transition-colors">Taslağı Kaydet</button>
            </div>
            <button class="p-2 text-error hover:bg-error-container/20 rounded-full transition-colors">
                <span class="material-symbols-outlined">delete</span>
            </button>
        </div>
    </form>
</div>