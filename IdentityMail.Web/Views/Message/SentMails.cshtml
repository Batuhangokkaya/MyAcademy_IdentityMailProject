@model List<UserMessage>
@{
    ViewData["Title"] = "Gönderilen Mailler";
    Layout            = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/sent-mails.css" asp-append-version="true" />
}

<div class="sent-mails-page">
    <div class="sent-mails-header">
        <div>
            <h1 class="sent-mails-title">Gönderilen Mesajlar</h1>
            <p class="sent-mails-count">@Model.Count Gönderilen Mesaj</p>
        </div>
        <div class="sent-mails-actions">
            <div class="sent-mails-bulk">
                <label class="sent-mails-bulk-item" title="Tümünü seç"><input type="checkbox" id="sentSelectAll" /></label>
                <button type="button" id="sentBulkImportantButton" class="sent-mails-bulk-item" title="Seçilenleri önemli yap" disabled><span class="material-symbols-outlined">star</span></button>
                <button type="button" id="sentBulkDeleteButton" class="sent-mails-bulk-item delete" title="Seçilenleri sil" disabled><span class="material-symbols-outlined">delete</span></button>
                <div class="sent-bulk-category-wrapper">
                    <select id="sentBulkCategorySelect" class="sent-bulk-category-select" disabled>
                        <option value="">Kategoriye Ekle</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.ID">@category.Name</option>
                            }
                        }
                        <option value="remove">Kategoriyi Kaldır</option>
                    </select>
                    <span class="material-symbols-outlined sent-bulk-category-arrow">keyboard_arrow_down</span>
                </div>
            </div>
            <select name="categoryId" class="sent-mails-select">
                <option value="">Kategori</option>
                @if (ViewBag.Categories != null)
                {
                    foreach (var category in ViewBag.Categories)
                    {
                        if (ViewBag.CurrentCategoryId == category.ID)
                        {
                            <option value="@category.ID" selected>@category.Name</option>
                        }
                        else
                        {
                            <option value="@category.ID">@category.Name</option>
                        }
                    }
                }
            </select>
            <select name="sort" class="sent-mails-select sent-mails-sort">
                @if (ViewBag.CurrentSort == "old")
                {
                    <option value="new">Sırala: En Yeni</option>
                    <option value="old" selected>Sırala: En Eski</option>
                }
                else
                {
                    <option value="new" selected>Sırala: En Yeni</option>
                    <option value="old">Sırala: En Eski</option>
                }
            </select>
        </div>
    </div>
    <div class="sent-mails-list">
        @foreach (var message in Model)
        {
            var body = message.Body ?? "";
            <div class="sent-mails-item">
                <div class="sent-mails-item-checkbox">
                    <input type="checkbox" class="sent-mail-checkbox" value="@message.ID" />
                </div>
                <div class="sent-mails-item-star">
                    <button type="button" class="sent-mails-important-button @(message.IsImportant ? "selected" : "")" title="Önemli mesaj" onclick="toggleImportant(event, @message.ID, this)">
                        <span id="important-@message.ID" class="material-symbols-outlined">@(message.IsImportant ? "star" : "star_border")</span>
                    </button>
                </div>
                <a asp-controller="Message" asp-action="MailDetail" asp-route-id="@message.ID" class="sent-mails-item-content">
                    <div class="sent-mails-user">
                        <div class="sent-mails-avatar">
                            @if (!string.IsNullOrWhiteSpace(message.Receiver?.ProfileImageURL))
                            {
                                <img src="@message.Receiver.ProfileImageURL" alt="Profil fotoğrafı" />
                            }
                            else
                            {
                                var initial = message.Receiver?.FirstName;

                                if (string.IsNullOrWhiteSpace(initial))
                                {
                                    initial = message.ReceiverMail;
                                }

                                <span>@(string.IsNullOrWhiteSpace(initial) ? "?" : initial.Substring(0, 1).ToUpper())</span>
                            }
                        </div>
                        <div class="sent-mails-name">
                            @if (message.Receiver != null)
                            {
                                @($"{message.Receiver.FirstName} {message.Receiver.LastName}")
                            }
                            else
                            {
                                @message.ReceiverMail
                            }
                        </div>
                    </div>
                    <div class="sent-mails-message">
                        <div class="sent-mails-subject">@message.Subject</div>
                        <div class="sent-mails-preview">@(body.Length > 45 ? body.Substring(0, 45) + "..." : body)</div>
                    </div>
                    <div class="mail-category">
                        @if (message.Category != null)
                        {
                            <div class="category-badge" style="color:@message.Category.Color; border-color:@message.Category.Color;">@message.Category.Name</div>
                        }
                    </div>
                    <div class="sent-mails-date">
                        @if (message.SendDate.Date == DateTime.Today)
                        {
                            @message.SendDate.ToString("HH:mm")
                        }
                        else if (message.SendDate.Year == DateTime.Now.Year)
                        {
                            @message.SendDate.ToString("dd MMM")
                        }
                        else
                        {
                            @message.SendDate.ToString("dd.MM.yyyy")
                        }
                    </div>
                </a>
                <div class="sent-mails-row-actions">
                    <form asp-controller="Message" asp-action="DeleteMail" asp-route-id="@message.ID" method="post" class="sent-mails-delete-form">
                        <button type="submit" class="sent-mails-delete-button" title="Sil"><span class="material-symbols-outlined">delete</span></button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
<div id="sentDeleteModal" class="sent-mails-modal" role="dialog" aria-modal="true" aria-labelledby="sentDeleteTitle" aria-hidden="true">
    <div class="sent-mails-modal-box">
        <div class="sent-mails-modal-icon">
            <span class="material-symbols-outlined">delete_forever</span>
        </div>
        <h2 id="sentDeleteTitle" class="sent-mails-modal-title">Mesajı Sil</h2>
        <p id="sentDeleteText" class="sent-mails-modal-text">Bu mesaj Gönderilen Mesajlar listenizden kaldırılacak.</p>
        <div class="sent-mails-modal-actions">
            <button type="button" id="sentDeleteCancel" class="sent-mails-modal-cancel">Vazgeç</button>
            <button type="button" id="sentDeleteConfirm" class="sent-mails-modal-confirm">Sil</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sent-mails.js" asp-append-version="true"></script>
}