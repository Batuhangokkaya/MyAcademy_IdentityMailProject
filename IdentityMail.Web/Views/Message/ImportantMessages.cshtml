@model List<UserMessage>
@{
    ViewData["Title"] = "Önemli Mesajlar";
    Layout            = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/important-mails.css" asp-append-version="true" />
}

<!-- Important Mails Header -->
<div class="important-header">
    <div>
        <h1 class="important-title">Önemli Mesajlar</h1>
        <p class="important-count">@Model.Count Önemli Mesaj</p>
    </div>
    <div class="important-header-actions">
        <button class="important-filter-btn">
            <span class="material-symbols-outlined">filter_list</span>
            Filtre
        </button>
        <button class="important-more-btn">
            <span class="material-symbols-outlined">more_vert</span>
        </button>
    </div>
</div>
<!-- Important Mail List -->
<div class="important-mail-container">
    <!-- List Header -->
    <div class="important-mail-list-header">
        <div class="important-checkbox-column">
            <input class="important-checkbox" type="checkbox" />
        </div>
        <div class="important-star-column"></div>
        <div class="important-sender-column">Gönderen</div>
        <div class="important-mail-column">Mail</div>
        <div class="important-date-column">Date</div>
    </div>
    <!-- Mail Rows -->
    @foreach (var message in Model)
    {
        <a asp-controller="Message" asp-action="MailDetail" asp-route-id="@message.ID" class="important-mail-row @(message.IsRead == false ? "unread" : "read")">
            <div class="important-checkbox-column">
                <input class="important-checkbox" type="checkbox" onclick="event.stopPropagation();" />
            </div>
            <div class="important-star-column">
                <span id="important-@message.ID" class="material-icons important-star active" onclick="toggleImportant(event, @message.ID, this); return false;">star</span>
            </div>
            <div class="important-sender-column important-sender @(message.IsRead == false ? "mail-bold" : "")">
                @message.Sender.FirstName @message.Sender.LastName
            </div>
            <div class="important-mail-column">
                @if (message.Category != null)
                {
                    <span class="important-category">@message.Category.Name</span>
                }
                <div class="important-mail-content">
                    <span class="important-subject @(message.IsRead == false ? "mail-bold" : "")">@message.Subject</span>
                    <span class="important-preview">- @(message.Body?.Length > 70 ? message.Body.Substring(0, 70) : message.Body)</span>
                </div>
            </div>
            <div class="important-date-column important-date @(message.IsRead == false ? "mail-bold" : "")">
                @if (message.SendDate.Date == DateTime.Today)
                {
                    @message.SendDate.ToString("HH:mm")
                }
                else if (message.SendDate.Year == DateTime.Now.Year)
                {
                    @message.SendDate.ToString("dd MMM")
                }
                else
                {
                    @message.SendDate.ToString("dd.MM.yyyy")
                }
            </div>
        </a>
    }
</div>