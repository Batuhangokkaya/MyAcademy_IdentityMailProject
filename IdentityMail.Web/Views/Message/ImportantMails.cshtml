@model List<UserMessage>
@{
    ViewData["Title"] = "Önemli Mesajlar";
    Layout            = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/message/important-mails.css" asp-append-version="true" />
}

<div class="important-page">    
    <div class="important-header">
        <div class="important-title-area">
            <h1>Önemli Mesajlar</h1>
            <p>@ViewBag.TotalMessages önemli mesaj</p>
        </div>
        <div class="important-actions">
            <div class="important-bulk-actions">
                <label class="important-bulk-select-all" title="Tümünü Seç">
                    <input id="importantSelectAll" type="checkbox" />
                </label>
                <button id="importantBulkStar" class="important-bulk-action-button important-bulk-star" type="button" title="Önem İşaretini Kaldır" disabled>
                    <span class="material-symbols-outlined">star</span>
                </button>
                <button id="importantBulkDelete" class="important-bulk-action-button delete" type="button" title="Sil" disabled>
                    <span class="material-symbols-outlined">delete</span>
                </button>
            </div>
            <div class="important-tabs">
                <a asp-controller="Message" asp-action="ImportantMails" asp-route-filter="all" asp-route-category="@ViewBag.CurrentCategory" asp-route-sort="@ViewBag.CurrentSort" class="important-tab-button @(ViewBag.CurrentFilter == "all" || ViewBag.CurrentFilter == null ? "active" : "")">Tümü</a>
                <a asp-controller="Message" asp-action="ImportantMails" asp-route-filter="unread" asp-route-category="@ViewBag.CurrentCategory" asp-route-sort="@ViewBag.CurrentSort" class="important-tab-button @(ViewBag.CurrentFilter == "unread" ? "active" : "")">Okunmamış</a>
                <a asp-controller="Message" asp-action="ImportantMails" asp-route-filter="read" asp-route-category="@ViewBag.CurrentCategory" asp-route-sort="@ViewBag.CurrentSort" class="important-tab-button @(ViewBag.CurrentFilter == "read" ? "active" : "")">Okunan</a>
            </div>
            <form asp-controller="Message" asp-action="ImportantMails" method="get" class="important-filter-form">
                <input type="hidden" name="filter" value="@ViewBag.CurrentFilter" />
                <div class="important-select-wrapper">
                    <select name="category" class="important-filter-select" onchange="this.form.submit()">
                        <option value="">Kategori</option>
                        @foreach (var category in ViewBag.Categories)
                        {
                            if (ViewBag.CurrentCategory == category.Name)
                            {
                                <option value="@category.Name" selected>@category.Name</option>
                            }
                            else
                            {
                                <option value="@category.Name">@category.Name</option>
                            }
                        }
                    </select>
                    <span class="material-symbols-outlined important-select-arrow">keyboard_arrow_down</span>
                </div>
                <div class="important-select-wrapper">
                    <select name="sort" class="important-filter-select" onchange="this.form.submit()">
                        @if (ViewBag.CurrentSort == "old")
                        {
                            <option value="new">Sırala: En Yeni</option>
                            <option value="old" selected>Sırala: En Eski</option>
                        }
                        else
                        {
                            <option value="new" selected>Sırala: En Yeni</option>
                            <option value="old">Sırala: En Eski</option>
                        }
                    </select>
                    <span class="material-symbols-outlined important-select-arrow">keyboard_arrow_down</span>
                </div>
            </form>
        </div>
    </div>
    <div class="important-mail-list">
        @foreach (var message in Model)
        {
            var isSent       = Convert.ToString(message.SenderID) == Convert.ToString((object)ViewBag.CurrentUserId);
            var person       = isSent ? message.Receiver : message.Sender;
            var personName   = person != null ? $"{person.FirstName} {person.LastName}".Trim() : "";
            var fallbackName = isSent ? message.ReceiverMail : "Gönderen bulunamadı";
            var displayName  = !string.IsNullOrWhiteSpace(personName) ? personName : (!string.IsNullOrWhiteSpace(fallbackName) ? fallbackName : "Alıcı bulunamadı");
            var initial      = !string.IsNullOrWhiteSpace(person?.FirstName) ? person.FirstName : displayName;
            <div class="important-mail-item @(message.IsRead == false ? "unread" : "")">
                <div class="important-mail-select">
                    <input class="important-mail-checkbox" type="checkbox" value="@message.ID" />
                </div>
                <button id="important-@message.ID" class="important-button selected" type="button" data-id="@message.ID" title="Önem İşaretini Kaldır">
                    <span class="material-symbols-outlined">star</span>
                </button>
                <a asp-controller="Message" asp-action="MailDetail" asp-route-id="@message.ID" class="important-mail-link">
                    <div class="important-mail-sender">
                        <div class="important-sender-avatar">
                            @if (!string.IsNullOrWhiteSpace(person?.ProfileImageURL))
                            {
                                <img src="@person.ProfileImageURL" alt="Profil fotoğrafı" />
                            }
                            else
                            {
                                <span>@(string.IsNullOrWhiteSpace(initial) ? "?" : initial.Substring(0, 1).ToUpper())</span>
                            }
                        </div>
                        <div class="important-sender-info">
                            <div class="important-sender-name">@displayName</div>
                        </div>
                    </div>
                    <div class="important-mail-content">
                        <div class="important-mail-subject">@message.Subject</div>
                        <div class="important-mail-preview">@(message.Body?.Length > 70 ? message.Body.Substring(0, 70) : message.Body)</div>
                    </div>
                    <div class="mail-category">
                        @if (message.Category != null)
                        {
                            <div class="category-badge" style="color:@message.Category.Color; border-color:@message.Category.Color;">@message.Category.Name</div>
                        }
                    </div>
                    <div class="important-mail-date">
                        @if (message.SendDate.Date == DateTime.Today)
                        {
                            @message.SendDate.ToString("HH:mm")
                        }
                        else if (message.SendDate.Year == DateTime.Now.Year)
                        {
                            @message.SendDate.ToString("dd MMM")
                        }
                        else
                        {
                            @message.SendDate.ToString("dd.MM.yyyy")
                        }
                    </div>
                </a>
                <div class="important-mail-actions">
                    <form asp-controller="Message" asp-action="DeleteMail" asp-route-id="@message.ID" asp-route-returnUrl="@Url.Action("ImportantMails", "Message")" asp-antiforgery="true" method="post" class="important-delete-form">
                        <button class="important-delete-mail-button" type="submit" title="Sil">
                            <span class="material-symbols-outlined">delete</span>
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
    <div class="important-pagination">

        <a asp-controller="Message" asp-action="ImportantMails" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-filter="@ViewBag.CurrentFilter" asp-route-category="@ViewBag.CurrentCategory" asp-route-sort="@ViewBag.CurrentSort" class="important-pagination-button @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
            <span class="material-symbols-outlined">chevron_left</span>
        </a>
        @for (int i = 1; i <= Math.Max(1, (int)ViewBag.TotalPages); i++)
        {
            <a asp-controller="Message" asp-action="ImportantMails" asp-route-page="@i" asp-route-filter="@ViewBag.CurrentFilter" asp-route-category="@ViewBag.CurrentCategory" asp-route-sort="@ViewBag.CurrentSort" class="important-pagination-button @(ViewBag.CurrentPage == i ? "active" : "")">@i</a>
        }
        <a asp-controller="Message" asp-action="ImportantMails" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-filter="@ViewBag.CurrentFilter" asp-route-category="@ViewBag.CurrentCategory" asp-route-sort="@ViewBag.CurrentSort" class="important-pagination-button @(ViewBag.CurrentPage >= Math.Max(1, (int)ViewBag.TotalPages) ? "disabled" : "")">
            <span class="material-symbols-outlined">chevron_right</span>
        </a>
    </div>
</div>
<div id="importantDeleteModal" class="important-modal" role="dialog" aria-modal="true" aria-labelledby="importantDeleteTitle" aria-describedby="importantDeleteText" aria-hidden="true">
    <div class="important-modal-box">
        <div class="important-modal-icon">
            <span class="material-symbols-outlined">delete</span>
        </div>
        <h2 id="importantDeleteTitle" class="important-modal-title">Mesaj Silinsin mi?</h2>
        <p id="importantDeleteText" class="important-modal-text">Bu mesaj Çöp Kutusu'na taşınacak.</p>
        <p id="importantDeleteError" class="important-modal-error" hidden></p>
        <div class="important-modal-actions">
            <button id="importantDeleteCancel" class="important-modal-cancel" type="button">Vazgeç</button>
            <button id="importantDeleteConfirm" class="important-modal-confirm" type="button">Sil</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/message/important-mails.js" asp-append-version="true"></script>
}