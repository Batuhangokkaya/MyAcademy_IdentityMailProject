@model List<UserMessage>
@{
    ViewData["Title"] = "Gelen Kutusu";
    Layout            = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/message/inbox.css" asp-append-version="true" />
}

<div class="inbox-page">
    <div class="inbox-header">
        <div class="inbox-title-area">
            <h1>Gelen Kutusu</h1>
            <p>@ViewBag.UnreadMessages okunmamış mesaj</p>
        </div>
        <div class="inbox-actions">
            <div class="bulk-actions">
                <label class="bulk-select-all" title="Tümünü seç">
                    <input type="checkbox" id="selectAllCheckbox" />
                </label>
                <button type="button" id="bulkImportantButton" class="bulk-action-button" title="Seçilenleri önemli yap" disabled>
                    <span class="material-symbols-outlined">star</span>
                </button>
                <button type="button" id="bulkDeleteButton" class="bulk-action-button delete" title="Seçilenleri sil" disabled>
                    <span class="material-symbols-outlined">delete</span>
                </button>
                <div class="bulk-category-wrapper">
                    <select id="bulkCategorySelect" class="bulk-category-select" disabled>
                        <option value="">Kategoriye Ekle</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.ID">
                                    @category.Name
                                </option>
                            }
                        }
                        <option value="remove">
                            Kategoriyi Kaldır
                        </option>
                    </select>
                    <span class="material-symbols-outlined bulk-category-arrow">keyboard_arrow_down</span>
                </div>
            </div>
            <div class="inbox-tabs">
                <a asp-controller="Message" asp-action="Inbox" asp-route-filter="all" asp-route-sort="@ViewBag.CurrentSort" asp-route-categoryID="@ViewBag.CurrentCategoryId" class="tab-button @(ViewBag.CurrentFilter == "all" ? "active" : "")">Tümü</a>
                <a asp-controller="Message" asp-action="Inbox" asp-route-filter="unread" asp-route-sort="@ViewBag.CurrentSort" asp-route-categoryID="@ViewBag.CurrentCategoryId" class="tab-button @(ViewBag.CurrentFilter == "unread" ? "active" : "")">Okunmamış</a>
                <a asp-controller="Message" asp-action="Inbox" asp-route-filter="read" asp-route-sort="@ViewBag.CurrentSort" asp-route-categoryID="@ViewBag.CurrentCategoryId" class="tab-button @(ViewBag.CurrentFilter == "read" ? "active" : "")">Okunan</a>
                <a asp-controller="Message" asp-action="Inbox" asp-route-filter="important" asp-route-sort="@ViewBag.CurrentSort" asp-route-categoryID="@ViewBag.CurrentCategoryId" class="tab-button @(ViewBag.CurrentFilter == "important" ? "active" : "")">
                    <span class="material-symbols-outlined inbox-important-filter-icon">star</span>
                    Önemli
                </a>
            </div>
            <form asp-controller="Message" asp-action="Inbox" method="get" class="inbox-filter-form">
                <input type="hidden" name="filter" value="@ViewBag.CurrentFilter" />
                <div class="inbox-select-wrapper">
                    <select name="categoryId" class="inbox-filter-select" onchange="this.form.submit()">
                        <option value="">Kategori</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var category in ViewBag.Categories)
                            {
                                if (ViewBag.CurrentCategoryId == category.ID)
                                {
                                    <option value="@category.ID" selected>@category.Name</option>
                                }
                                else
                                {
                                    <option value="@category.ID">@category.Name</option>
                                }
                            }
                        }
                    </select>
                    <span class="material-symbols-outlined inbox-select-arrow">keyboard_arrow_down</span>
                </div>
                <div class="inbox-select-wrapper">
                    <select name="sort" class="inbox-filter-select" onchange="this.form.submit()">
                        @if (ViewBag.CurrentSort == "old")
                        {
                            <option value="new">Sırala: En Yeni</option>
                            <option value="old" selected>Sırala: En Eski</option>
                        }
                        else
                        {
                            <option value="new" selected>Sırala: En Yeni</option>
                            <option value="old">Sırala: En Eski</option>
                        }
                    </select>
                    <span class="material-symbols-outlined inbox-select-arrow">keyboard_arrow_down</span>
                </div>
            </form>
        </div>
    </div>
    <div class="mail-list">
        @foreach (var message in Model)
        {
            var body = message.Body ?? "";
            <div class="mail-item @(message.IsRead == false ? "unread" : "")">
                <div class="mail-select">
                    <input type="checkbox" class="mail-checkbox" value="@message.ID" />
                </div>
                <button type="button" class="important-button @(message.IsImportant ? "selected" : "")" data-important="@(message.IsImportant ? "true" : "false")" title="Önemli mesaj" onclick="toggleImportant(event, @message.ID, this)">
                    <span class="material-symbols-outlined">@(message.IsImportant ? "star" : "star_border")</span>
                </button>
                <a asp-controller="Message" asp-action="MailDetail" asp-route-id="@message.ID" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" asp-route-returnText="Gelen Kutusuna Dön" class="mail-link">
                    <div class="mail-sender">
                        <div class="sender-avatar">
                            @if (!string.IsNullOrWhiteSpace(message.Receiver?.ProfileImageURL))
                            {
                                <img src="@message.Receiver.ProfileImageURL" alt="Profil fotoğrafı" />
                            }
                            else
                            {
                                var initial = message.Receiver?.FirstName;

                                if (string.IsNullOrWhiteSpace(initial))
                                {
                                    initial = message.ReceiverMail;
                                }

                                <span>@(string.IsNullOrWhiteSpace(initial) ? "?" : initial.Substring(0, 1).ToUpper())</span>
                            }
                        </div>
                        <div class="sender-info">
                            <div class="sender-name">
                                @message.Sender.FirstName
                                @message.Sender.LastName
                            </div>
                        </div>
                    </div>
                    <div class="mail-content">
                        <div class="mail-subject">@message.Subject</div>
                        <div class="mail-preview">@(body.Length > 45 ? body.Substring(0, 45) + "..." : body)</div>
                    </div>
                    <div class="mail-category">
                        @if (message.Category != null)
                        {
                            <div class="category-badge" style="color:@message.Category.Color; border-color:@message.Category.Color;">@message.Category.Name</div>
                        }
                    </div>
                    <div class="mail-date">
                        @if (message.SendDate.Date == DateTime.Today)
                        {
                            @message.SendDate.ToString("HH:mm")
                        }
                        else if (message.SendDate.Year == DateTime.Now.Year)
                        {
                            @message.SendDate.ToString("dd MMM")
                        }
                        else
                        {
                            @message.SendDate.ToString("dd.MM.yyyy")
                        }
                    </div>
                    <div class="mail-actions">
                        <form asp-controller="Message" asp-action="DeleteMail" asp-route-id="@message.ID" method="post" class="single-delete-form">
                            <button type="submit" class="delete-mail-button" title="Sil">
                                <span class="material-symbols-outlined">delete</span>
                            </button>
                        </form>
                    </div>
                </a>
            </div>
        }
    </div>
    <div class="inbox-pagination">
        <a asp-controller="Message" asp-action="Inbox" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-filter="@ViewBag.CurrentFilter" asp-route-sort="@ViewBag.CurrentSort" asp-route-categoryID="@ViewBag.CurrentCategoryId" class="pagination-button @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
            <span class="material-symbols-outlined">chevron_left</span>
        </a>
        @for (int i = 1; i <= Math.Max(1, (int)ViewBag.TotalPages); i++)
        {
            <a asp-controller="Message" asp-action="Inbox" asp-route-page="@i" asp-route-filter="@ViewBag.CurrentFilter" asp-route-sort="@ViewBag.CurrentSort" asp-route-categoryID="@ViewBag.CurrentCategoryId" class="pagination-button @(ViewBag.CurrentPage == i ? "active" : "")">@i</a>
        }
        <a asp-controller="Message" asp-action="Inbox" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-filter="@ViewBag.CurrentFilter" asp-route-sort="@ViewBag.CurrentSort" asp-route-categoryID="@ViewBag.CurrentCategoryId" class="pagination-button @(ViewBag.CurrentPage >= Math.Max(1, (int)ViewBag.TotalPages) ? "disabled" : "")">
            <span class="material-symbols-outlined">chevron_right</span>
        </a>
    </div>
</div>
<div id="inboxDeleteModal" class="inbox-delete-modal" role="dialog" aria-modal="true" aria-labelledby="inboxDeleteTitle" aria-hidden="true">
    <div class="inbox-delete-modal-box">
        <div class="inbox-delete-modal-icon">
            <span class="material-symbols-outlined">delete</span>
        </div>
        <h2 class="inbox-delete-modal-title" id="inboxDeleteTitle">Mesajı Sil</h2>
        <p class="inbox-delete-modal-text" id="inboxDeleteText">Bu mesaj Çöp Kutusu'na taşınacak.</p>
        <div class="inbox-delete-modal-actions">
            <button type="button" class="inbox-delete-cancel" id="inboxDeleteCancel">Vazgeç</button>
            <button type="button" class="inbox-delete-confirm" id="inboxDeleteConfirm">Sil</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/message/inbox.js" asp-append-version="true"></script>
}