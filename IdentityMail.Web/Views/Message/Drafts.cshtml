@model List<UserMessage>
@{
    ViewData["Title"] = "Taslaklar";
    Layout            = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/drafts.css" />
}

<div class="drafts-header">
    <div>
        <h1 class="drafts-title">Taslaklar</h1>
        <p class="drafts-count">@Model.Count Taslak</p>
    </div>
    <div class="drafts-header-actions">
        <button class="drafts-filter-btn">
            <span class="material-symbols-outlined">filter_list</span>
            Filtre
        </button>
        <button class="drafts-more-btn">
            <span class="material-symbols-outlined">more_vert</span>
        </button>
    </div>
</div>
<div class="drafts-container">
    <div class="drafts-table-header">
        <div class="drafts-checkbox-header">
            <input type="checkbox" />
        </div>
        <div class="drafts-receiver-header">Taslak</div>
        <div class="drafts-mail-header">Mail</div>
        <div class="drafts-date-header">Tarih</div>
    </div>
    @foreach (var message in Model)
    {
        <div class="drafts-row" onclick="openDraft(@message.ID)">
            <div class="drafts-checkbox">
                <input type="checkbox" onclick="event.preventDefault();event.stopPropagation();" />
            </div>
            <div class="drafts-receiver">
                @if (message.Receiver != null)
                {
                    <span>@message.Receiver.FirstName @message.Receiver.LastName</span>
                }
                else
                {
                    <span class="drafts-empty">Alıcı yok</span>
                }
            </div>
            <div class="drafts-mail">
                <span class="drafts-badge">Taslak</span>
                <div class="drafts-mail-content">
                    @if (!string.IsNullOrWhiteSpace(message.Subject))
                    {
                        <span class="drafts-subject">@message.Subject</span>
                    }
                    else
                    {
                        <span class="drafts-no-subject">Konu yok</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(message.Body))
                    {
                        <span class="drafts-body">- @(message.Body.Length > 70 ? message.Body.Substring(0, 70) : message.Body)</span>
                    }
                </div>
            </div>
            <div class="drafts-date">
                @if (message.SendDate.Date == DateTime.Today)
                {
                    @message.SendDate.ToString("HH:mm")
                }
                else if (message.SendDate.Year == DateTime.Now.Year)
                {
                    @message.SendDate.ToString("dd MMM")
                }
                else
                {
                    @message.SendDate.ToString("dd.MM.yyyy")
                }
            </div>
        </div>
    }
</div>