@model List<UserMessage>
@{
    ViewData["Title"] = "Taslaklar";
    Layout            = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/drafts.css" asp-append-version="true" />
}

<div class="drafts-header">
    <div class="drafts-header-left">
        <h1 class="drafts-title">Taslaklar</h1>
        <p class="drafts-count">@Model.Count Taslak</p>
    </div>
    <div class="drafts-header-actions">
        <div class="drafts-action-group">
            <label class="drafts-action-check" title="Tümünü Seç">
                <input type="checkbox" id="selectAllDrafts" />
            </label>
            <button type="button" class="drafts-action-btn" id="deleteSelectedDrafts" disabled title="Seçilenleri Sil">
                <span class="material-symbols-outlined">delete</span>
            </button>
        </div>
        <div class="drafts-category-group">
            <a asp-controller="Message" asp-action="Drafts" asp-route-filter="all" asp-route-sort="@ViewBag.Sort" class="drafts-tab @(ViewBag.Filter == "all" ? "active" : "")">Tümü</a>
            <a asp-controller="Message" asp-action="Drafts" asp-route-filter="withReceiver" asp-route-sort="@ViewBag.Sort" class="drafts-tab @(ViewBag.Filter == "withReceiver" ? "active" : "")">Alıcısı Olan</a>
            <a asp-controller="Message" asp-action="Drafts" asp-route-filter="withoutReceiver" asp-route-sort="@ViewBag.Sort" class="drafts-tab @(ViewBag.Filter == "withoutReceiver" ? "active" : "")">Alıcısı Olmayan</a>
            <a asp-controller="Message" asp-action="Drafts" asp-route-filter="withSubject" asp-route-sort="@ViewBag.Sort" class="drafts-tab @(ViewBag.Filter == "withSubject" ? "active" : "")">Konusu Olan</a>
            <a asp-controller="Message" asp-action="Drafts" asp-route-filter="withoutSubject" asp-route-sort="@ViewBag.Sort" class="drafts-tab @(ViewBag.Filter == "withoutSubject" ? "active" : "")">Konusu Olmayan</a>
        </div>
        <form asp-controller="Message" asp-action="Drafts" method="get" class="drafts-sort-form">
            <input type="hidden" name="filter" value="@ViewBag.Filter" />
            <div class="drafts-select-wrapper">
                <select name="sort" class="drafts-filter-select" onchange="this.form.submit()">
                    @if (ViewBag.Sort == "old")
                    {
                        <option value="new">Sırala: En Yeni</option>
                        <option value="old" selected>Sırala: En Eski</option>
                    }
                    else
                    {
                        <option value="new" selected>Sırala: En Yeni</option>
                        <option value="old">Sırala: En Eski</option>
                    }
                </select>
                <span class="material-symbols-outlined drafts-select-arrow">keyboard_arrow_down</span>
            </div>
        </form>
    </div>
</div>
<div class="drafts-list">
    @foreach (var message in Model)
    {
        <div class="drafts-row" onclick="openDraft(@message.ID)">
            <div class="drafts-checkbox">
                <input type="checkbox" class="draft-checkbox" value="@message.ID" onclick="event.stopPropagation();" />
            </div>
            <div class="drafts-receiver">
                @if (message.Receiver != null)
                {
                    <span>@message.Receiver.FirstName @message.Receiver.LastName</span>
                }
                else if (!string.IsNullOrWhiteSpace(message.ReceiverMail))
                {
                    <span>@message.ReceiverMail</span>
                }
                else
                {
                    <span class="drafts-empty">Alıcı yok</span>
                }
            </div>
            <div class="drafts-mail">
                <span class="drafts-badge">Taslak</span>
                <div class="drafts-mail-content">
                    @if (!string.IsNullOrWhiteSpace(message.Subject))
                    {
                        <span class="drafts-subject">@message.Subject</span>
                    }
                    else
                    {
                        <span class="drafts-no-subject">Konu yok</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(message.Body))
                    {
                        <span class="drafts-body">- @(message.Body.Length > 70 ? message.Body.Substring(0, 70) : message.Body)</span>
                    }
                </div>
            </div>
            <div class="drafts-date">
                <span class="drafts-date-text">
                    @if (message.SendDate.Date == DateTime.Today)
                    {
                        @message.SendDate.ToString("HH:mm")
                    }
                    else if (message.SendDate.Year == DateTime.Now.Year)
                    {
                        @message.SendDate.ToString("dd MMM")
                    }
                    else
                    {
                        @message.SendDate.ToString("dd.MM.yyyy")
                    }
                </span>
                <form asp-controller="Message" asp-action="DeleteMail" asp-route-id="@message.ID" asp-route-returnUrl="@Url.Action("Drafts","Message")" asp-antiforgery="false" method="post" class="drafts-delete-form" onclick="event.stopPropagation();">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="drafts-row-delete" title="Taslağı Sil">
                        <span class="material-symbols-outlined">delete</span>
                    </button>
                </form>
            </div>
        </div>
    }
</div>
<div id="draftsDeleteModal" class="drafts-modal" role="dialog" aria-modal="true" aria-labelledby="draftsModalTitle" aria-describedby="draftsModalText" aria-hidden="true">
    <div class="drafts-modal-box">
        <div class="drafts-modal-icon">
            <span class="material-symbols-outlined">delete_forever</span>
        </div>
        <h2 class="drafts-modal-title" id="draftsModalTitle">Taslağı Sil</h2>
        <p class="drafts-modal-text" id="draftsModalText">Bu taslağı silmek istediğinize emin misiniz?</p>
        <p class="drafts-modal-error" id="draftsModalError" role="alert" hidden></p>
        <div class="drafts-modal-buttons">
            <button type="button" class="drafts-modal-cancel" id="draftsModalCancel">Vazgeç</button>
            <button type="button" class="drafts-modal-confirm" id="draftsModalConfirm">Sil</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/drafts.js" asp-append-version="true"></script>
}