@model UserMessage
@{
    ViewData["Title"] = "Mail Detayı";
    Layout            = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/message-detail.css" asp-append-version="true" />
}

<div class="message-detail-page">
    <div class="message-detail-toolbar">
        <a asp-controller="Message" asp-action="Inbox" class="back-button"><span class="material-symbols-outlined">arrow_back</span><span>Gelen Kutusuna Dön</span></a>
        <div class="toolbar-actions">
            <button type="button" class="toolbar-button important-button"><span class="material-symbols-outlined">star</span><span>Önemli</span></button>
            <form asp-controller="Message" asp-action="DeleteMail" asp-route-id="@Model.ID" method="post">
                <button type="submit" class="toolbar-button"><span class="material-symbols-outlined">delete</span><span>Çöp Kutusuna Taşı</span></button>
            </form>
            <button type="button" class="toolbar-icon-button" title="Okunmadı olarak işaretle"><span class="material-symbols-outlined">mark_email_unread</span></button>
            <button type="button" class="toolbar-icon-button" title="Daha Fazla"><span class="material-symbols-outlined">more_vert</span></button>
        </div>
    </div>
    <div class="message-detail-divider"></div>
    <article class="message-card">
        <div class="message-card-content">
            <div class="message-title-section">
                <h1 class="message-title">@Model.Subject</h1>
                <div class="message-meta">
                    <span class="message-category"><span class="category-dot"></span>İş</span>
                    <span class="message-read-status"><span class="material-symbols-outlined">mail</span>Okundu</span>
                </div>
            </div>
            <div class="message-divider"></div>
            <div class="sender-section">
                <div class="sender-left">
                    <div class="sender-avatar">
                        @{
                            var senderInitial = !string.IsNullOrEmpty(Model.Sender?.FirstName) ? Model.Sender.FirstName.Substring(0, 1).ToUpper() : "U";
                        }
                        <span>@senderInitial</span>
                    </div>
                    <div class="sender-info">
                        <div class="sender-main-info">
                            <span class="sender-name">@Model.Sender?.FirstName @Model.Sender?.LastName</span>
                            <span class="sender-email">&lt;@Model.Sender?.Email&gt;</span>
                        </div>
                        <div class="sender-sub-info">
                            <span>Kime:</span>
                            <span class="receiver-badge">Bana</span>
                            <span class="send-date">@Model.SendDate.ToString("dd MMMM yyyy, HH:mm")</span>
                        </div>
                    </div>
                </div>
                <div class="sender-actions">
                    <button type="button" class="sender-action-button important"><span class="material-symbols-outlined">star</span></button>
                    <button type="button" class="sender-action-button"><span class="material-symbols-outlined">reply</span></button>
                    <button type="button" class="sender-action-button"><span class="material-symbols-outlined">more_horiz</span></button>
                </div>
            </div>
            <div class="message-body">@Model.Body</div>
            <div class="attachment-card">
                <div class="attachment-left">
                    <div class="attachment-icon"><span class="material-symbols-outlined">description</span></div>
                    <div class="attachment-info">
                        <span class="attachment-name">Proje_Ilerleme_Raporu_Q3.pdf</span>
                        <span class="attachment-details">2.4 MB • PDF Belgesi</span>
                    </div>
                </div>
                <button type="button" class="attachment-download"><span class="material-symbols-outlined">download</span><span>İndir</span></button>
            </div>
            <div class="message-bottom-divider"></div>
            <div class="message-footer">
                <button type="button" class="reply-button"><span class="material-symbols-outlined">reply</span><span>Yanıtla</span></button>
                <button type="button" class="forward-button"><span class="material-symbols-outlined">forward</span><span>İlet</span></button>
            </div>
        </div>
    </article>
</div>