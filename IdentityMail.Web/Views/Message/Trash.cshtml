@model List<UserMessage>
@{
    ViewData["Title"] = "Silinen Mesajlar";
    Layout            = "~/Views/Shared/_Layout.cshtml";
    var userId        = (int)ViewBag.UserId;
}
@section Styles {
    <link rel="stylesheet" href="~/css/message/trash.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()
<div class="trash-page" data-restore-url="@Url.Action("RestoreTrash", "Message")" data-remove-url="@Url.Action("RemoveFromTrash", "Message")" data-empty-url="@Url.Action("EmptyTrash", "Message")">    
    <div class="trash-header">
        <div class="trash-header-left">
            <h1 class="trash-title">Silinen Mesajlar</h1>
            <p class="trash-subtitle">@ViewBag.TotalMessages Silinen Mesaj</p>
        </div>
        <div class="trash-header-actions">
            <label class="trash-select-all">
                <input type="checkbox" id="trashSelectAll" />
                <span>Tümünü Seç</span>
            </label>
            <button type="button" id="trashRestoreButton" class="trash-restore-button" disabled>
                <span class="material-symbols-outlined">restore_from_trash</span>
                Geri Yükle
            </button>
            <button type="button" id="trashSelectedDeleteButton" class="trash-selected-delete-button" disabled>
                <span class="material-symbols-outlined">delete</span>
                Seçilenleri Sil
            </button>
            <div class="trash-filter-wrapper">
                <button type="button" id="trashFilterButton" class="trash-filter-button">
                    <span class="material-symbols-outlined">filter_list</span>
                    <span id="trashFilterText">
                        @switch ((string)ViewBag.CurrentFilter)
                        {
                            case "received":
                                @:Gelen Mesajlar
                                break;
                            case "sent":
                                @:Gönderilen Mesajlar
                                break;
                            case "important":
                                @:Önemli Mesajlar
                                break;
                            default:
                                @:Tümü
                                break;
                        }
                    </span>
                    <span class="material-symbols-outlined">keyboard_arrow_down</span>
                </button>
                <div id="trashFilterMenu" class="trash-filter-menu">
                    <a asp-controller="Message" asp-action="Trash" asp-route-filter="all" class="trash-filter-option @(ViewBag.CurrentFilter == "all" ? "active" : "")">Tümü</a>
                    <a asp-controller="Message" asp-action="Trash" asp-route-filter="received" class="trash-filter-option @(ViewBag.CurrentFilter == "received" ? "active" : "")">Gelen Mesajlar</a>
                    <a asp-controller="Message" asp-action="Trash" asp-route-filter="sent" class="trash-filter-option @(ViewBag.CurrentFilter == "sent" ? "active" : "")">Gönderilen Mesajlar</a>
                    <a asp-controller="Message" asp-action="Trash" asp-route-filter="important" class="trash-filter-option @(ViewBag.CurrentFilter == "important" ? "active" : "")">Önemli Mesajlar</a>
                </div>
            </div>
            <button type="button" id="trashEmptyButton" class="trash-empty-button" disabled>
                <span class="material-symbols-outlined">delete_forever</span>
                Çöp Kutusunu Boşalt
            </button>
        </div>
    </div>
    <div class="trash-list">
        @if (Model.Any())
        {
            foreach (var message in Model)
            {
                var isSent           = message.SenderID == userId;
                var isDraft          = message.IsDraft;
                string personName;
                string? profileImage = null;
                string initial       = "?";
                if (isDraft)
                {
                    personName = !string.IsNullOrWhiteSpace(message.ReceiverMail) ? message.ReceiverMail : "Alıcı yok";
                }
                else if (isSent)
                {
                    if (message.Receiver != null)
                    {
                        personName = $"{message.Receiver.FirstName} {message.Receiver.LastName}".Trim();
                        profileImage = message.Receiver.ProfileImageURL;
                        if (!string.IsNullOrWhiteSpace(message.Receiver.FirstName))
                        {
                            initial = message.Receiver.FirstName.Substring(0, 1).ToUpper();
                        }
                    }
                    else
                    {
                        personName = !string.IsNullOrWhiteSpace(message.ReceiverMail) ? message.ReceiverMail : "Alıcı adresi bilinmiyor";
                        if (!string.IsNullOrWhiteSpace(message.ReceiverMail))
                        {
                            initial = message.ReceiverMail.Substring(0, 1).ToUpper();
                        }
                    }
                }
                else
                {
                    if (message.Sender != null)
                    {
                        personName   = $"{message.Sender.FirstName} {message.Sender.LastName}".Trim();
                        profileImage = message.Sender.ProfileImageURL;
                        if (!string.IsNullOrWhiteSpace(message.Sender.FirstName))
                        {
                            initial = message.Sender.FirstName.Substring(0, 1).ToUpper();
                        }
                    }
                    else
                    {
                        personName = "Gönderen bulunamadı";
                    }
                }
                <div class="trash-row" data-id="@message.ID" data-type="@(isSent ? "sent" : "received")" data-important="@message.IsImportant.ToString().ToLower()" onclick="showTrashWarning()">
                    <div class="trash-checkbox" onclick="event.stopPropagation();">
                        <input type="checkbox" class="trash-mail-checkbox" value="@message.ID" />
                    </div>
                    <div class="trash-person">
                        @if (isDraft)
                        {
                            <div class="trash-draft-avatar">
                                <span class="material-symbols-outlined">draft</span>
                            </div>
                        }
                        else
                        {
                            <div class="trash-avatar">
                                @if (!string.IsNullOrWhiteSpace(profileImage))
                                {
                                    <img src="@profileImage" alt="Profil fotoğrafı" />
                                }
                                else
                                {
                                    <span>@initial</span>
                                }
                            </div>
                        }
                        <div class="trash-person-info">
                            <span class="trash-person-name">@personName</span>
                            @if (isDraft)
                            {
                                <span class="trash-draft-label">Taslak</span>
                            }
                            else if (isSent)
                            {
                                <span class="trash-message-type">Gönderilen</span>
                            }
                            else
                            {
                                <span class="trash-message-type">Gelen</span>
                            }
                        </div>
                    </div>
                    <div class="trash-message">
                        <span class="trash-subject">@(string.IsNullOrWhiteSpace(message.Subject) ? "Konu yok" : message.Subject)</span>
                        @if (!string.IsNullOrWhiteSpace(message.Body))
                        {
                            <span class="trash-body">- @(message.Body.Length > 45 ? message.Body.Substring(0, 45) + "..." : message.Body)</span>
                        }
                    </div>
                    <div class="mail-category">
                        @if (!isDraft && message.Category != null)
                        {
                            <div class="category-badge" style="color:@message.Category.Color; border-color:@message.Category.Color;">@message.Category.Name</div>
                        }
                    </div>
                    <div class="trash-date-area">
                        <span class="trash-date">
                            @if (message.SendDate.Date == DateTime.Today)
                            {
                                @message.SendDate.ToString("HH:mm")
                            }
                            else if (message.SendDate.Year == DateTime.Now.Year)
                            {
                                @message.SendDate.ToString("dd MMM")
                            }
                            else
                            {
                                @message.SendDate.ToString("dd.MM.yyyy")
                            }
                        </span>
                        <button type="button" class="trash-delete-button" data-id="@message.ID" title="Çöp Kutusundan Kaldır" onclick="event.stopPropagation();">
                            <span class="material-symbols-outlined">delete</span>
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="trash-empty">
                <span class="material-symbols-outlined trash-empty-icon">delete</span>
                <h2 class="trash-empty-title">Çöp Kutusu Boş</h2>
                <p class="trash-empty-text">Silinen mesajlar burada görünecek.</p>
            </div>
        }
    </div>
    <div class="trash-pagination">
        <a asp-controller="Message" asp-action="Trash" asp-route-page="@(ViewBag.CurrentPage - 1)" class="trash-pagination-button @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
            <span class="material-symbols-outlined">chevron_left</span>
        </a>
        @for (int i = 1; i <= Math.Max(1, (int)ViewBag.TotalPages); i++)
        {
            <a asp-controller="Message" asp-action="Trash" asp-route-page="@i" class="trash-pagination-button @(ViewBag.CurrentPage == i ? "active" : "")">@i</a>
        }
        <a asp-controller="Message" asp-action="Trash" asp-route-page="@(ViewBag.CurrentPage + 1)" class="trash-pagination-button @(ViewBag.CurrentPage >= Math.Max(1, (int)ViewBag.TotalPages) ? "disabled" : "")">
            <span class="material-symbols-outlined">chevron_right</span>
        </a>
    </div>
</div>
<div id="trashModal" class="trash-modal" role="dialog" aria-modal="true" aria-labelledby="trashWarningTitle" aria-hidden="true">
    <div class="trash-modal-box">
        <div class="trash-modal-icon">
            <span class="material-symbols-outlined">warning</span>
        </div>
        <h2 id="trashWarningTitle" class="trash-modal-title">Mesaj Çöp Kutusunda</h2>
        <p class="trash-modal-text">Mesajı görüntülemek için lütfen Çöp Kutusu'ndan çıkarın.</p>
        <button type="button" class="trash-modal-button" onclick="closeTrashWarning()">Tamam</button>
    </div>
</div>
<div id="trashActionModal" class="trash-modal" role="dialog" aria-modal="true" aria-labelledby="trashActionTitle" aria-hidden="true">
    <div class="trash-modal-box">
        <div class="trash-modal-icon">
            <span class="material-symbols-outlined">delete_forever</span>
        </div>
        <h2 class="trash-modal-title"id="trashActionTitle">Mesajı Çöp Kutusundan Kaldır</h2>
        <p class="trash-modal-text"id="trashActionText">Bu mesaj çöp kutunuzdan kaldırılacak. Mesaj kaydı veritabanında kalacak.</p>
        <div class="trash-action-buttons">
            <button type="button" class="trash-action-cancel" id="trashActionCancel">Vazgeç</button>
            <button type="button" class="trash-action-confirm" id="trashActionConfirm">Kaldır</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/message/trash.js" asp-append-version="true"></script>
}