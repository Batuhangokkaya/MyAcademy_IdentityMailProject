@model List<Category>
@{
    ViewData["Title"] = "Kategoriler";
}
@section Styles {
    <link rel="stylesheet" href="~/css/category/category-index.css" asp-append-version="true" />
}

<div class="category-page">
    <div class="category-header">
        <div class="category-header-left">
            <h1 class="category-title">Kategoriler</h1>
            <p class="category-subtitle">Mesajlarınızı kategoriler halinde düzenleyin.</p>
        </div>
        <div class="category-header-right">
            <a asp-controller="Category" asp-action="Create" class="category-add-button">
                <span class="material-symbols-outlined">add</span>
                <span>Yeni Kategori</span>
            </a>
        </div>
    </div>
    <div class="category-box">
        <div class="category-box-header">
            <h2 class="category-box-title">Kategorileriniz</h2>
        </div>
        <div class="category-box-body">
            @if (Model != null && Model.Any())
            {
                foreach (var category in Model)
                {
                    <div class="category-row">
                        <div class="category-row-left">
                            <span class="material-symbols-outlined category-icon" style="color:@category.Color">label</span>
                            <span class="category-name">@category.Name</span>
                        </div>
                        <div class="category-row-actions">
                            <a asp-controller="Category" asp-action="Edit" asp-route-id="@category.ID" class="category-action-button edit-button" title="Düzenle">
                                <span class="material-symbols-outlined">edit</span>
                            </a>
                            <form asp-controller="Category" asp-action="Delete" asp-route-id="@category.ID" method="post" class="category-delete-form">
                                <button type="button" class="category-delete-button" data-id="@category.ID" data-name="@category.Name">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="category-empty">
                    <span class="material-symbols-outlined category-empty-icon">label_off</span>
                    <p>Henüz bir kategoriniz bulunmuyor.</p>
                </div>
            }
        </div>
    </div>
    <div class="category-pagination">
        <a asp-controller="Category" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" class="category-pagination-button @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
            <span class="material-symbols-outlined">chevron_left</span>
        </a>
        @for (int i = 1; i <= Math.Max(1, (int)ViewBag.TotalPages); i++)
        {
            <a asp-controller="Category" asp-action="Index" asp-route-page="@i" class="category-pagination-button @(ViewBag.CurrentPage == i ? "active" : "")">@i</a>
        }
        <a asp-controller="Category" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" class="category-pagination-button @(ViewBag.CurrentPage >= Math.Max(1, (int)ViewBag.TotalPages) ? "disabled" : "")">
            <span class="material-symbols-outlined">chevron_right</span>
        </a>
    </div>
</div>
<div id="categoryModal" class="category-modal" role="dialog" aria-modal="true" aria-labelledby="categoryWarningTitle" aria-hidden="true">
    <div class="category-modal-box">
        <div class="category-modal-icon">
            <span class="material-symbols-outlined">warning</span>
        </div>
        <h2 id="categoryWarningTitle" class="category-modal-title">Kategori İşlemi</h2>
        <p id="categoryWarningText" class="category-modal-text">Kategoriyle ilgili işlem gerçekleştirilemedi.</p>
        <button type="button" class="category-modal-button" onclick="closeCategoryWarning()">Tamam</button>
    </div>
</div>
<div id="categoryActionModal" class="category-modal" role="dialog" aria-modal="true" aria-labelledby="categoryActionTitle" aria-hidden="true">
    <div class="category-modal-box">
        <div class="category-modal-icon category-modal-icon-danger">
            <span class="material-symbols-outlined">delete_forever</span>
        </div>
        <h2 id="categoryActionTitle" class="category-modal-title">Kategoriyi Sil</h2>
        <p class="category-modal-text"><strong id="categoryDeleteName"></strong>kategorisini silmek istediğinizden emin misiniz?</p>
        <div class="category-action-buttons">
            <button type="button" class="category-action-cancel" id="categoryActionCancel">Vazgeç</button>
            <form id="categoryDeleteForm" asp-controller="Category" asp-action="Delete" method="post">
                <input type="hidden" name="id" id="categoryDeleteId" />
                <button type="submit" class="category-action-confirm" id="categoryActionConfirm">Kategoriyi Sil</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/category/category-index.js" asp-append-version="true"></script>
}