@model List<Category>
@{
    ViewData["Title"] = "Kategoriler";
}
@section Styles {
    <link rel="stylesheet" href="~/css/category/category-index.css" asp-append-version="true" />
}

<div class="category-page">
    <!-- PAGE HEADER -->
    <div class="category-header">
        <div class="category-header-left">
            <h1 class="category-title">Kategoriler</h1>
            <p class="category-subtitle">Mesajlarınızı kategoriler halinde düzenleyin.</p>
        </div>
        <div class="category-header-right">
            <a asp-controller="Category" asp-action="Create" class="category-add-button">
                <span class="material-symbols-outlined">add</span>
                <span>Yeni Kategori</span>
            </a>
        </div>
    </div>
    <!-- CATEGORY BOX -->
    <div class="category-box">
        <!-- BOX HEADER -->
        <div class="category-box-header">
            <h2 class="category-box-title">Kategorileriniz</h2>
        </div>
        <!-- BOX BODY -->
        <div class="category-box-body">
            @if (Model != null && Model.Any())
            {
                foreach (var category in Model)
                {
                    <div class="category-row">
                        <div class="category-row-left">
                            <span class="material-symbols-outlined category-icon">label</span>
                            <span class="category-name">@category.Name</span>
                        </div>
                        <div class="category-row-actions">
                            <a asp-controller="Category" asp-action="Edit" asp-route-id="@category.ID" class="category-action-button edit-button" title="Düzenle">
                                <span class="material-symbols-outlined">edit</span>
                            </a>
                            <form asp-controller="Category" asp-action="Delete" asp-route-id="@category.ID" method="post" class="category-delete-form">
                                <button type="submit" class="category-action-button delete-button" title="Sil" onclick="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="category-empty">
                    <span class="material-symbols-outlined category-empty-icon">label_off</span>
                    <p>Henüz bir kategoriniz bulunmuyor.</p>
                </div>
            }
        </div>
    </div>
</div>