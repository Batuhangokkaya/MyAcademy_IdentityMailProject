@model Category
@section Styles {
    <link rel="stylesheet" href="~/css/category/category-edit.css" asp-append-version="true" />
}

<div class="category-edit-page">
    <div class="category-edit-header">
        <h1>Kategoriyi Düzenle</h1>
        <p>Kategori adını ve rengini güncelleyin.</p>
    </div>
    <div class="category-edit-card">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="ID" />
            <div class="category-edit-form-group">
                <label asp-for="Name">Kategori Adı</label>
                <input asp-for="Name" type="text" class="category-edit-input" />
                <span asp-validation-for="Name" class="category-edit-validation"></span>
            </div>
            <div class="category-edit-form-group">
                <label>Kategori Rengi</label>
                <input asp-for="Color" type="hidden" id="categoryColor" />
                <div class="category-color-list">                   
                    @{
                        var colors = new[]
                        {
                            new { Code = "#2563EB", Name = "Mavi" },
                            new { Code = "#EF4444", Name = "Kırmızı" },
                            new { Code = "#F97316", Name = "Turuncu" },
                            new { Code = "#F59E0B", Name = "Sarı" },
                            new { Code = "#22C55E", Name = "Yeşil" },
                            new { Code = "#14B8A6", Name = "Turkuaz" },
                            new { Code = "#13aff0", Name = "Gök Mavi" },
                            new { Code = "#8B5CF6", Name = "Mor" },
                            new { Code = "#EC4899", Name = "Pembe" },
                            new { Code = "#64748B", Name = "Gri" }
                        };
                    }
                    @for (int i = 0; i < 10; i++)
                    {
                        <button type="button" class="category-color" data-color="@colors[i].Code" style="--category-color:@colors[i].Code" aria-label="@colors[i].Name"></button>
                    }
                </div>
            </div>
            <div class="category-edit-actions">
                <a asp-action="Index" class="category-edit-cancel">İptal</a>
                <button type="submit" class="category-edit-save">Değişiklikleri Kaydet</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/category/category-edit.js" asp-append-version="true"></script>
}