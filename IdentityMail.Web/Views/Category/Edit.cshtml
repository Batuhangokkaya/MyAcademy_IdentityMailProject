@model Category

<div class="p-6">
    <div class="mb-6">
        <h1 class="text-2xl font-semibold text-on-surface">Kategoriyi Düzenle</h1>
        <p class="mt-1 text-sm text-on-surface-variant">Kategori adını güncelleyin.</p>
    </div>
    <div class="max-w-xl bg-surface-container-lowest border border-outline-variant rounded-xl p-6">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="ID" />
            <div class="mb-5">
                <label asp-for="Name" class="block mb-2 text-sm font-medium text-on-surface">Kategori Adı</label>
                <input asp-for="Name" type="text" class="w-full px-4 py-2.5 rounded-lg border border-outline-variant bg-surface text-on-surface outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary" />
                <span asp-validation-for="Name" class="text-sm text-error"></span>
            </div>
            <div class="flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-4 py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container-low">İptal</a>
                <button type="submit" class="px-5 py-2.5 rounded-lg bg-primary text-on-primary hover:opacity-90 transition">Değişiklikleri Kaydet</button>
            </div>
        </form>
    </div>
</div>